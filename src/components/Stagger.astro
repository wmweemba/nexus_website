---
/**
 * Staggered block reveal — children arrive in sequence rather than as one
 * block. Drop-in replacement for <Reveal> wherever a block has two or more
 * children worth sequencing (an eyebrow, a heading, a paragraph).
 *
 * Carries `.reveal` as well as `.stagger` on purpose: browsers without
 * scroll-timeline fall back to the plain block fade driven by the
 * IntersectionObserver in Reveal.astro, and the supporting branch cancels the
 * parent's own animation so the two never compound. See the .stagger block in
 * src/styles/scroll-system.css.
 *
 * Only the first six children are staggered (the CSS sets --i up to
 * :nth-child(6)); anything beyond that reveals with the sixth. That is a
 * deliberate ceiling — a heading block with seven staggered parts is a design
 * problem, not a missing CSS rule.
 */
interface Props {
  as?: string;
  class?: string;
}

const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['reveal', 'stagger', className]}>
  <slot />
</Tag>

<script>
  // Mirrors Reveal.astro: only the no-scroll-timeline branch needs JS, and it
  // treats the whole stagger block as one plain reveal. Astro dedupes this
  // across both components, so nothing ships twice.
  if (!CSS.supports('animation-timeline', 'scroll()')) {
    const targets = document.querySelectorAll('.stagger');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
    );

    for (const el of targets) {
      el.classList.add('js-fallback');
      io.observe(el);
    }
  }
</script>
