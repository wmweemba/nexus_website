---
/**
 * Primary navigation. Always-rendered link list — no disclosure widget, no
 * JavaScript, nothing to fail on Opera Mini or with scripting disabled. Wraps
 * to a second line on narrow viewports instead of collapsing behind a
 * hamburger. See docs/DECISIONS.md — p2-nav.
 */
const links = [
  { href: '/services/', label: 'Services' },
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="nav" data-ground="dark">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">Nexus</a>
    <nav aria-label="Primary">
      <ul class="nav-list">
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    padding-block: var(--space-4);
    background: var(--ink);
    color: var(--paper);
  }

  .nav-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .nav-logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-1);
    color: var(--paper);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    list-style: none;
  }

  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--text--1);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--paper);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .nav-list a:hover {
    border-bottom-color: var(--cyan);
  }
</style>
