---
/**
 * Wraps content in the `.reveal` scroll-in primitive. In browsers that
 * support native scroll-driven animation (animation-timeline), the CSS in
 * src/styles/scroll-system.css does all the work with zero JS. Everywhere
 * else (Firefox stable, per docs/UI_UX_SPEC.md §6), the script below is a
 * plainer IntersectionObserver fallback — the only JS this site ships, and
 * it degrades to "content is simply visible" if disabled. See
 * docs/DECISIONS.md for the justification required by CLAUDE.md rule 1.
 *
 * Astro dedupes an identical inline <script> across multiple uses of this
 * component on one page, so this only ships once regardless of how many
 * <Reveal> instances a page has.
 */
interface Props {
  as?: string;
  class?: string;
}

const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['reveal', className]}>
  <slot />
</Tag>

<script>
  if (!CSS.supports('animation-timeline', 'scroll()')) {
    const targets = document.querySelectorAll('.reveal');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
    );

    for (const el of targets) {
      el.classList.add('js-fallback');
      io.observe(el);
    }
  }
</script>
