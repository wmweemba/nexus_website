---
/**
 * Services — `/services/`. Phase 5 build of docs/copy/services.md. An
 * overview that hands off to the dedicated `/services/security-awareness/`
 * page rather than selling the wedge in full here.
 */
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Reveal from '../components/Reveal.astro';

const services = [
  {
    n: '01',
    title: 'Cyber security & compliance',
    body: 'Security awareness and phishing simulation, gap assessments, policy packs, incident-response plans, and the documentation an examiner expects.',
    cta: { label: 'The security-awareness programme in detail', href: '/services/security-awareness/' },
  },
  {
    n: '02',
    title: 'Microsoft 365 & infrastructure',
    body: 'Tenant hardening, MFA and Conditional Access, Defender, mail flow and email authentication. Firewalls, site-to-site VPN and 3CX telephony.',
    detail:
      'Microsoft 365 tenant hardening enforces MFA, configures Defender, and sets the Exchange and Conditional Access policy that stops the phishing which gets through despite training. Firewall hardening with site-to-site VPN reviews and tightens a FortiGate or Sophos estate, and links branches securely to head office.',
  },
  {
    n: '03',
    title: 'Web design & development',
    body: 'Business websites built to load quickly on a Zambian mobile connection, structured to be found in search, and handed over properly rather than held hostage.',
  },
  {
    n: '04',
    title: 'Hosting & domains',
    body: 'Managed hosting on infrastructure we operate, domain registration and renewal, business email, SSL, backups and monitoring — on an annual retainer.',
  },
  {
    n: '05',
    title: 'Business systems',
    body: 'Where an off-the-shelf product does not fit, we build. A loan management system and a credit-risk dashboard are both running in production today.',
  },
  {
    n: '06',
    title: 'ICT supply & procurement',
    body: 'Hardware, licensing and network equipment sourced and configured, so what arrives is ready to use rather than ready to unbox.',
  },
];

const steps = [
  {
    title: 'A short scoping call',
    body: 'Thirty minutes. We establish what you are actually required to fix, by when, and who is asking. No charge, no obligation to continue.',
  },
  {
    title: 'Something concrete, free',
    body: 'Before you commit, you get a real deliverable: a findings sheet on your current exposure, or a working mock-up of the site. Built from your situation, not a template.',
  },
  {
    title: 'A fixed price',
    body: 'Scope and price agreed in writing before work starts. We do not bill by the hour, and we do not revise the number mid-engagement unless you change what you asked for.',
  },
  {
    title: 'Delivery, then handover',
    body: 'You get the documentation, the credentials and the administrative access. Everything we build is yours, and you are never locked in by us holding a password.',
  },
  {
    title: 'The retainer, if it earns its place',
    body: 'Ongoing work is a separate decision, taken after delivery. Some clients need it monthly, some annually, some not at all.',
  },
];

const quoteShapes = [
  {
    title: 'A one-off project',
    body: 'A website, a tenant hardening, a firewall build. Fixed price agreed up front and billed against milestones. Nothing recurring unless you ask for it.',
  },
  {
    title: 'A programme with a retainer',
    body: 'Security awareness works this way. The build is one-off; running the campaigns and producing the reports is monthly or annual, and you decide which after the build.',
  },
  {
    title: 'An annual retainer',
    body: 'Hosting, domains, email and support, billed once a year against one invoice and one purchase order.',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Cyber security and compliance, Microsoft 365 and infrastructure, web design and development, hosting and domains, business systems, and ICT procurement — six services, delivered by the same team that runs them afterwards."
    />
    <title>Services — Nexus Consulting Services</title>
  </head>
  <body class="bg-paper text-ink">
    <Nav />

    <main>
      <Section ground="light" id="services-header">
        <Reveal as="div">
          <p class="chip">What we do</p>
          <h1 class="mt-4 font-display font-bold text-balance" style="font-size: var(--text-5); max-width: 22ch">
            Six things, and we do all of them ourselves
          </h1>
          <p class="mt-6 max-w-[55ch]" style="color: var(--slate)">
            The security work is where we lead, but it is rarely all a client needs. Most
            engagements start in one column and end up spanning several.
          </p>
        </Reveal>
      </Section>

      <Section ground="dark" id="services-list">
        <div class="services-grid">
          {services.map((service) => (
            <Reveal as="article" class="service-card">
              <p class="font-mono" style="font-size: var(--text--1); color: var(--cyan)">{service.n}</p>
              <h2 class="mt-3 font-display font-semibold" style="font-size: var(--text-2)">{service.title}</h2>
              <p class="mt-3" style="color: var(--steel)">{service.body}</p>
              {service.detail && (
                <p class="mt-3" style="color: var(--steel)">{service.detail}</p>
              )}
              {service.cta && (
                <a href={service.cta.href} class="service-cta mt-4">{service.cta.label} →</a>
              )}
            </Reveal>
          ))}
        </div>

        <blockquote class="services-pullquote mt-12">
          <p style="font-size: var(--text-2)">
            If we cannot do it properly, we say so and point you to someone who can. That
            has cost us work and kept us clients.
          </p>
        </blockquote>
      </Section>

      <Section ground="light" id="how-we-work">
        <Reveal as="div">
          <p class="chip">How we work</p>
          <h2 class="mt-4 font-display font-bold text-balance" style="font-size: var(--text-4)">
            You see the work before you pay for it
          </h2>
        </Reveal>

        <ol class="steps mt-10">
          {steps.map((step, i) => (
            <Reveal as="li" class="step">
              <p class="font-mono" style="font-size: var(--text--1); color: var(--cyan-deep)">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-2 font-display font-semibold" style="font-size: var(--text-1)">{step.title}</h3>
              <p class="mt-2" style="color: var(--slate)">{step.body}</p>
            </Reveal>
          ))}
        </ol>

        <div class="mt-12">
          <h3 class="font-display font-semibold" style="font-size: var(--text-1)">How we quote — three shapes</h3>
          <div class="mt-6 grid gap-6 md:grid-cols-3">
            {quoteShapes.map((shape) => (
              <div>
                <p class="font-display font-semibold" style="font-size: var(--text-0)">{shape.title}</p>
                <p class="mt-2" style="color: var(--slate)">{shape.body}</p>
              </div>
            ))}
          </div>
          <p class="mt-6 font-mono" style="font-size: var(--text--1); color: var(--steel)">
            Website work carries a 50% deposit. Everything else is agreed at quotation. We
            do not bill by the hour.
          </p>
        </div>

        <a href="/contact/" class="btn btn-primary mt-10">Start with the scoping call</a>
      </Section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .services-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .service-card {
    border-radius: var(--radius-md);
    padding: var(--space-6);
    background: color-mix(in srgb, var(--paper) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--paper) 15%, transparent);
  }

  .service-cta {
    display: inline-block;
    color: var(--cyan);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .service-cta:hover {
    border-bottom-color: var(--cyan);
  }

  .services-pullquote {
    max-width: 44ch;
    border-inline-start: 2px solid var(--cyan);
    padding-inline-start: var(--space-5);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .steps {
    list-style: none;
    display: grid;
    gap: var(--space-8);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
</style>
