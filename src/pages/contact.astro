---
/**
 * Contact — `/contact/`. Per docs/copy/contact.md and CLAUDE.md rule 1
 * (no JS unless a feature genuinely cannot work without it) — a static site
 * has no server to receive a form POST, and a hosted form backend is a
 * third-party dependency this repo doesn't have an account for. The mailto
 * path is the primary and only mechanism; see docs/DECISIONS.md.
 */
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Reveal from '../components/Reveal.astro';
import Seo from '../components/Seo.astro';

const team = [
  { name: 'William S. Mweemba', title: 'Managing Consultant', email: 'william@mynexusgroup.com' },
  { name: 'Elias Mulenga', title: 'Chief Technology Officer', email: 'elias@mynexusgroup.com' },
  { name: 'Farai Liwewe', title: 'Director', email: 'farai@mynexusgroup.com' },
];

const checklist = [
  'Your name and organisation',
  'What you are trying to fix',
  'Any deadline you are working against — an audit date, a renewal, a launch',
];

const scopingSubject = encodeURIComponent('Scoping call request');
const scopingBody = encodeURIComponent(
  'Name:\nOrganisation:\n\nWhat are you trying to fix?\n\n',
);
const scopingMailto = `mailto:info@mynexusgroup.com?subject=${scopingSubject}&body=${scopingBody}`;
---

<html lang="en">
  <head>
    <Seo
      title="Contact — Nexus Consulting Services"
      description="Start with a free, thirty-minute scoping call. No charge, no obligation. Write to info@mynexusgroup.com or call +260 954 156 056."
      breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }]}
    />
  </head>
  <body class="bg-paper text-ink">
    <Nav />

    <main>
      <Section ground="dark" id="contact-header">
        <Reveal as="div">
          <p class="chip">Get in touch</p>
          <h1 class="mt-4 font-display font-bold text-balance" style="font-size: var(--text-5); max-width: 20ch">
            Start with the scoping call.
          </h1>
          <p class="mt-6 max-w-[55ch]" style="color: var(--steel)">
            If you are carrying a finding, renewing a website, or simply unsure whether your
            current setup would survive being looked at closely — that first conversation
            costs you nothing and usually tells you what you need to know.
          </p>
        </Reveal>
      </Section>

      <Section ground="light" id="contact-details">
        <div class="contact-grid">
          <Reveal as="div" class="contact-primary">
            <h2 class="font-display font-semibold" style="font-size: var(--text-2)">Request a scoping call</h2>
            <p class="mt-3" style="color: var(--slate)">Include, if you can:</p>
            <ul class="mt-3 checklist">
              {checklist.map((item) => (
                <li style="color: var(--slate)">{item}</li>
              ))}
            </ul>
            <a href={scopingMailto} class="btn btn-primary mt-6">Request a scoping call</a>
            <p class="mt-3 font-mono" style="font-size: var(--text--1); color: var(--steel)">
              Opens your email client, addressed to info@mynexusgroup.com.
            </p>
          </Reveal>

          <Reveal as="div" class="contact-info">
            <h2 class="font-display font-semibold" style="font-size: var(--text-1)">General</h2>
            <p class="mt-3"><a href="tel:+260954156056">+260 954 156 056</a></p>
            <p class="mt-1"><a href="mailto:info@mynexusgroup.com">info@mynexusgroup.com</a></p>
            <p class="mt-1" style="color: var(--slate)">Plot 9 Katopola Road, Rhodes Park, Lusaka</p>
            <p class="mt-1"><a href="https://mynexusgroup.com">mynexusgroup.com</a></p>

            <h2 class="mt-8 font-display font-semibold" style="font-size: var(--text-1)">Team</h2>
            <ul class="mt-3 team-list">
              {team.map((person) => (
                <li>
                  <p style="font-weight: 600">{person.name}</p>
                  <p class="font-mono" style="font-size: var(--text--1); color: var(--steel)">{person.title}</p>
                  <p><a href={`mailto:${person.email}`}>{person.email}</a></p>
                </li>
              ))}
            </ul>
          </Reveal>
        </div>
      </Section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-10);
    grid-template-columns: 1.3fr 1fr;
  }

  @media (max-width: 48rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  .contact-primary,
  .contact-info {
    border-radius: var(--radius-md);
    padding: var(--space-8);
    background: var(--mist);
  }

  .checklist {
    display: grid;
    gap: var(--space-2);
    padding-inline-start: 1.2em;
  }

  .contact-info a {
    color: var(--cyan-deep);
  }

  .team-list {
    display: grid;
    gap: var(--space-5);
  }
</style>
