---
/**
 * Home — `/`. Phase 4 assembly of the approved copy in docs/copy/home.md
 * against the components built in Phases 2–3. Section order and ground
 * assignments follow the alternating dark/light rhythm in
 * docs/UI_UX_SPEC.md §3: dark hero+gap, light wedge, dark services, light
 * work, dark close.
 */
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import NodeGraph from '../components/NodeGraph.astro';
import Reveal from '../components/Reveal.astro';
import PhoneShowcase from '../components/PhoneShowcase.astro';
import HorizontalScroll from '../components/HorizontalScroll.astro';
import Seo from '../components/Seo.astro';

const services = [
  {
    title: 'Cyber security & compliance',
    body: 'Security awareness and phishing simulation, gap assessments, policy packs, incident-response plans, and the documentation an examiner expects.',
  },
  {
    title: 'Microsoft 365 & infrastructure',
    body: 'Tenant hardening, MFA and Conditional Access, Defender, mail flow. Firewalls, site-to-site VPN and 3CX telephony.',
  },
  {
    title: 'Web design & development',
    body: 'Business websites built to load quickly on a Zambian mobile connection, structured to be found in search, and handed over properly.',
  },
  {
    title: 'Hosting & domains',
    body: 'Managed hosting on infrastructure we operate, domain registration, business email, SSL, backups and monitoring — on an annual retainer.',
  },
  {
    title: 'Business systems',
    body: "Where an off-the-shelf product doesn't fit, we build. A loan management system and a credit-risk dashboard are both running in production today.",
  },
  {
    title: 'ICT supply & procurement',
    body: 'Hardware, licensing and network equipment sourced and configured, so what arrives is ready to use rather than ready to unbox.',
  },
];
---

<html lang="en">
  <head>
    <Seo
      title="Nexus Consulting Services — IT that has to stand up to scrutiny"
      description="Compliance-driven IT for Zambian businesses that answer to a regulator: security awareness and phishing-simulation programmes, Microsoft 365 and infrastructure, web and business-systems development, managed hosting, and ICT procurement."
      breadcrumbs={[{ name: 'Home', path: '/' }]}
    />
    <link rel="preload" href="/fonts/sora-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plex-sans-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-paper text-ink">
    <Nav />

    <main>
      <Section ground="dark" id="hero" class="hero-section">
        <div class="hero-graphic">
          <NodeGraph nodeCount={11} density={0.4} opacity={0.9} seed={2} ground="dark" />
        </div>

        <div class="hero-content">
          <p class="chip">Nexus Consulting</p>
          <h1 class="mt-4 font-display font-bold text-balance" style="font-size: var(--text-6); max-width: 20ch">
            IT that has to stand up to scrutiny
          </h1>
          <p class="mt-6 max-w-[45ch] font-body" style="font-size: var(--text-1); color: var(--steel)">
            Compliance-driven IT for Zambian businesses that answer to a regulator — and the
            businesses that serve them.
          </p>

          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/contact/" class="btn btn-primary">Start with a scoping call</a>
            <a href="/work/" class="btn btn-ghost">See what we build</a>
          </div>
        </div>

        <div class="hero-content mt-16 grid gap-8 md:grid-cols-2" style="max-width: var(--content-max)">
          <p style="color: var(--steel)">
            Most of our clients answer to someone. A regulator, an auditor, a board, or a
            customer who wants to know where their data is kept. That work has a different
            shape from ordinary IT support: the question is not only whether a control
            works, but whether you can demonstrate that it works, to someone whose job is to
            doubt you.
          </p>
          <p style="color: var(--steel)">
            That is the gap we are built for. We deploy open-source and commodity
            technology to the standard a supervised institution needs, then document it the
            way an examiner expects to read it. We stay on to run it afterwards.
          </p>
        </div>

        <blockquote class="hero-pullquote hero-content mt-12">
          <p style={`font-size: var(--text-2)`}>
            We are small on purpose. You deal with the person who does the work, not an
            account manager who relays it.
          </p>
        </blockquote>
      </Section>

      <Section ground="light" id="wedge">
        <Reveal as="div">
          <p class="chip">What we lead with</p>
          <h2 class="mt-4 font-display font-bold text-balance" style="font-size: var(--text-4); max-width: 24ch">
            Closing the audit finding without a per-seat licence
          </h2>
          <div class="mt-6 grid gap-6 md:grid-cols-2" style="max-width: var(--content-max)">
            <p style="color: var(--slate)">
              Every regulated lender in Zambia carries some version of the same finding:
              staff security awareness is not being measured, and there is nothing on file
              to prove otherwise. The platforms built to close it are priced per seat in US
              dollars — for a sixty-person microfinance institution that is not a budget
              line.
            </p>
            <p style="color: var(--slate)">
              We built the affordable version inside a Bank of Zambia-supervised
              institution, where it closed the finding it was commissioned to close. That is
              what we now deploy and operate for clients — monthly phishing simulation,
              automatic remedial training, new-joiner onboarding, quarterly content refresh.
              No per-seat fee, no forex exposure.
            </p>
          </div>
          <a href="/services/security-awareness/" class="btn btn-primary mt-8">See how it works</a>
        </Reveal>
      </Section>

      <Section ground="dark" id="services">
        <Reveal as="div">
          <p class="chip">What we do</p>
          <h2 class="mt-4 font-display font-bold text-balance" style="font-size: var(--text-4)">
            Six things, and we do all of them ourselves
          </h2>
        </Reveal>

        <div class="mt-10">
          <HorizontalScroll label="What Nexus does">
            {services.map((service) => (
              <article class="hscroll-card rounded-md p-6" style="background: color-mix(in srgb, var(--paper) 6%, transparent); border: 1px solid color-mix(in srgb, var(--paper) 15%, transparent)">
                <h3 class="font-display font-semibold" style="font-size: var(--text-1)">{service.title}</h3>
                <p class="mt-2" style="color: var(--steel)">{service.body}</p>
              </article>
            ))}
          </HorizontalScroll>
        </div>

        <div class="services-footer mt-12 grid gap-10 md:grid-cols-2 md:items-center">
          <div>
            <blockquote>
              <p style={`font-size: var(--text-2)`}>
                If we cannot do it properly, we say so and point you to someone who can. That
                has cost us work and kept us clients.
              </p>
            </blockquote>
            <a href="/services/" class="btn btn-ghost mt-8">All services</a>
          </div>
          <div>
            <PhoneShowcase />
            <p class="text-center font-mono text-xs uppercase tracking-[0.1em]" style="color: var(--steel)">
              BazaBooks — one of our own builds, invoicing software for Zambian SMEs
            </p>
          </div>
        </div>
      </Section>

      <Section ground="light" id="work">
        <Reveal as="div">
          <p class="chip">Selected work</p>
          <h2 class="mt-4 font-display font-bold text-balance" style="font-size: var(--text-4)">
            What we have actually built
          </h2>
        </Reveal>

        <div class="mt-10 grid gap-6 md:grid-cols-2">
          <Reveal as="div" class="work-card">
            <a href="/work/ndalamahub/" class="work-card-link" style="display: block; border-radius: var(--radius-md); padding: var(--space-6); background: var(--mist)">
              <p class="font-mono text-xs uppercase tracking-[0.16em]" style="color: var(--cyan-deep)">Lending management system</p>
              <h3 class="mt-2 font-display font-semibold" style="font-size: var(--text-2)">NdalamaHub</h3>
              <p class="mt-2" style="color: var(--slate)">
                Borrower intake, application review queue, disbursement controls, a rollover
                engine and a collateral register. Live in production.
              </p>
            </a>
          </Reveal>

          <Reveal as="div" class="work-card">
            <div style="border-radius: var(--radius-md); padding: var(--space-6); border: 1px dashed var(--mist); height: 100%">
              <p class="font-mono text-xs uppercase tracking-[0.16em]" style="color: var(--steel)">More on file</p>
              <p class="mt-2" style="color: var(--slate)">
                NdalamaHub is a representative sample rather than a full list — including a
                security awareness programme run inside a Bank of Zambia-supervised
                institution, unnamed per client sensitivity. References available on request.
              </p>
            </div>
          </Reveal>
        </div>

        <a href="/work/" class="btn btn-primary mt-10">See the work</a>
      </Section>

      <Section ground="dark" id="close">
        <Reveal as="div">
          <h2 class="font-display font-bold text-balance" style="font-size: var(--text-4); max-width: 20ch">
            Start with the scoping call.
          </h2>
          <p class="mt-4 max-w-[55ch]" style="color: var(--steel)">
            If you are carrying a finding, renewing a website, or simply unsure whether your
            current setup would survive being looked at closely — that first conversation
            costs you nothing and usually tells you what you need to know.
          </p>
          <a href="/contact/" class="btn btn-primary mt-8">Book a scoping call</a>
        </Reveal>
      </Section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .hero-section {
    position: relative;
    overflow: hidden;
  }

  .hero-graphic {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-graphic :global(svg) {
    width: 100%;
    height: 100%;
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-pullquote,
  .services-footer blockquote {
    max-width: 40ch;
    border-inline-start: 2px solid var(--cyan);
    padding-inline-start: var(--space-5);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .work-card {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease;
  }

  .work-card:hover {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card {
      transition: none;
    }

    .work-card:hover {
      transform: none;
    }
  }
</style>
